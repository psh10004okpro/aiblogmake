# Application Settings
APP_NAME=Blog Automation System
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/blog_automation
DB_ECHO=False
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_EXPIRE=3600

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=Asia/Seoul
CELERY_ENABLE_UTC=True

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-organization-id
# ChatGPT for content generation
CHATGPT_MODEL=gpt-4o
CHATGPT_MAX_TOKENS=4000
CHATGPT_TEMPERATURE=0.7
# DALL-E 3 for image generation
DALLE_MODEL=dall-e-3
DALLE_SIZE=1792x1024
DALLE_QUALITY=hd
# GPT-4 Vision for alt text
GPT_VISION_MODEL=gpt-4-vision-preview

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=4000
CLAUDE_TEMPERATURE=0.7

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro-latest
GEMINI_MAX_TOKENS=4000
GEMINI_TEMPERATURE=0.7

# Default LLM Provider for content generation (claude, chatgpt, or gemini)
DEFAULT_LLM_PROVIDER=claude

# Google Ads API (Keyword Planner)
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-client-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=123-456-7890

# Naver Search Ad API
NAVER_API_KEY=your-naver-api-key
NAVER_SECRET_KEY=your-naver-secret-key
NAVER_CUSTOMER_ID=your-customer-id

# Unsplash API
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
UNSPLASH_SECRET_KEY=your-unsplash-secret-key

# WordPress Configuration
WP_URL=https://your-blog.com
WP_USERNAME=your-username
WP_APP_PASSWORD=your-application-password
WP_API_TIMEOUT=30

# AdSense Configuration
ADSENSE_CLIENT_ID=ca-pub-1234567890123456
ADSENSE_AD_SLOT_INLINE=1234567890
ADSENSE_AD_SLOT_SIDEBAR=0987654321
ADSENSE_AUTO_ADS=True

# Content Generation Settings
MIN_CONTENT_LENGTH=1500
MAX_CONTENT_LENGTH=3000
TARGET_WORD_COUNT=2000
MIN_IMAGES_PER_POST=3
MAX_IMAGES_PER_POST=5
INTERNAL_LINKS_MIN=3
INTERNAL_LINKS_MAX=5

# Keyword Research Settings
MIN_SEARCH_VOLUME=100
MAX_COMPETITION=0.7
MIN_CPC=0.1
TOP_KEYWORDS_COUNT=20

# Image Settings
IMAGE_HERO_WIDTH=1792
IMAGE_HERO_HEIGHT=1024
IMAGE_THUMBNAIL_WIDTH=800
IMAGE_THUMBNAIL_HEIGHT=600
IMAGE_MAX_SIZE_KB=200
IMAGE_FORMAT=webp
IMAGE_QUALITY=85
WATERMARK_TEXT=YourBlog.com
WATERMARK_OPACITY=128

# SEO Settings
SITEMAP_UPDATE_FREQUENCY=daily
META_DESCRIPTION_LENGTH=160
ALT_TEXT_MAX_LENGTH=125
ENABLE_SCHEMA_MARKUP=True
ENABLE_OPEN_GRAPH=True
ENABLE_TWITTER_CARDS=True

# Scheduling Settings
PUBLISH_TIME=09:00
PUBLISH_TIMEZONE=Asia/Seoul
AUTO_PUBLISH_ENABLED=True
POST_FREQUENCY_DAYS=1
DAILY_AUTO_PUBLISH_KEYWORDS=블로그,SEO,마케팅,디지털마케팅,콘텐츠마케팅

# Scraping Settings
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT=30000
SCRAPING_DELAY_MIN=1
SCRAPING_DELAY_MAX=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Monitoring
SENTRY_DSN=your-sentry-dsn-here
SENTRY_TRACES_SAMPLE_RATE=0.1

# Email Notifications (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
NOTIFY_EMAILS=admin@yourblog.com

# Slack Notifications (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#blog-automation

# Notification Settings
ENABLE_EMAIL_NOTIFICATIONS=False
ENABLE_SLACK_NOTIFICATIONS=False
NOTIFY_ON_WORKFLOW_START=False
NOTIFY_ON_WORKFLOW_COMPLETE=True
NOTIFY_ON_WORKFLOW_FAIL=True
NOTIFY_ON_POST_PUBLISH=False

# Feature Flags
ENABLE_KEYWORD_RESEARCH=True
ENABLE_AUTO_IMAGES=True
ENABLE_ADSENSE_AUTO_INSERT=True
ENABLE_AUTO_PUBLISH=True
ENABLE_NAVER_AUTOCOMPLETE=True
